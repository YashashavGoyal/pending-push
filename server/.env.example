# Server Configuration
PORT=2024
HOST=127.0.0.1
NODE_ENV=development

# Client Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Example: postgresql://username:password@localhost:5432/pending_push
# Cloud (Neon / Supabase): postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/pending_push

# JWT Authentication Secrets
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# OmniSocket Realtime Engine Configuration
OMNISOCKET_URL=https://omni-socket.onrender.com
OMNISOCKET_APP_ID=pending_push
OMNISOCKET_API_KEY=your_omnisocket_master_api_key_here
